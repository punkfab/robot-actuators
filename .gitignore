# python env / caches
.venv/
__pycache__/
*.pyc

# OS cruft
.DS_Store

# mujoco runtime log
MUJOCO_LOG.TXT

# regenerated by `make sts3215-synthetic`
sts3215/out/synthetic_logs/

# RobStride vendor STEP/BREP (fetched on demand, no licence stated) and big/regenerated outputs
robstride/cad/
robstride/out/lineup.step
robstride/out/*.npz

# qdd-liquid CAD meshes (regenerated by `make qdd-liquid-cad`; assembly.step is kept)
qdd-liquid/out/cad/*.stl
qdd-liquid/out/shallow.txt
qdd-liquid/out/render/*.glb

# qdd-liquid paper build intermediates
qdd-liquid/paper/main.aux
qdd-liquid/paper/main.log
qdd-liquid/paper/main.out
qdd-liquid/paper/main.bbl
qdd-liquid/paper/main.blg

# FEMM solutions and generated scripts (the .fem/.feh problem files and the json results are kept)
qdd-liquid/out/femm/*.ans
qdd-liquid/out/femm/*.anh
qdd-liquid/out/femm/*.lua
qdd-liquid/out/femm/*.txt
qdd-liquid/out/femm/*.png
qdd-liquid/out/femm/xauth

# rollerscrew CAD meshes and render scenes (regenerated by make rollerscrew-cad / -render; assembly.step is kept)
rollerscrew/out/cad/*.stl
rollerscrew/out/render/*.glb

# rv CAD meshes, STEP (14 MB) and render scenes: regenerated by make rv-cad / rv-render
rv/out/cad/*.stl
rv/out/render/*.glb
rv/out/rcf.txt
rv/out/cad/assembly.step
rv/out/sim_frames/
rv/out/sim_meshes/
rv/out/printed/*.stl
rv/out/printed/assembly.step
rv/out/explode/
rv/out/assemble/
rv/out/rv_assembly_quick.mp4
rv/out/*.log
